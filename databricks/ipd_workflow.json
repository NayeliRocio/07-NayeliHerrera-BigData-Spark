{
  "name": "IPD - GitHub sync y S3 a Silver-Gold",
  "description": "Sincroniza main, procesa el CSV desde S3, genera un archivo Gold en el bucket y lo consume para crear una tabla de indicadores.",
  "max_concurrent_runs": 1,
  "timeout_seconds": 2400,
  "schedule": {
    "quartz_cron_expression": "0 0 7 * * ?",
    "timezone_id": "America/Lima",
    "pause_status": "UNPAUSED"
  },
  "git_source": {
    "git_url": "https://github.com/NayeliRocio/07-NayeliHerrera-BigData-Spark.git",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "tasks": [
    {
      "task_key": "sync_git_folder",
      "notebook_task": {
        "notebook_path": "notebooks/00_sync_git_folder",
        "source": "GIT",
        "base_parameters": {"repo_id": "152918773774445", "git_branch": "main"}
      },
      "timeout_seconds": 600,
      "max_retries": 1,
      "min_retry_interval_millis": 30000
    },
    {
      "task_key": "copy_source_to_s3",
      "depends_on": [
        {
          "task_key": "sync_git_folder"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/00_copy_source_to_s3",
        "source": "GIT",
        "base_parameters": {
          "source_path": "/Volumes/ipd_catalog/default/source_uploads/deportistas_eventos_internacionales.csv",
          "target_path": "s3://ipd-nayeli-s3/raw/deportistas_eventos_internacionales.csv"
        }
      },
      "timeout_seconds": 600,
      "max_retries": 1,
      "min_retry_interval_millis": 30000
    },
    {
      "task_key": "s3_to_silver",
      "depends_on": [
        {"task_key": "sync_git_folder"},
        {"task_key": "copy_source_to_s3"}
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/nayeli.herrera@vallegrande.edu.pe/07-NayeliHerrera-BigData-Spark/notebooks/01_s3_to_silver",
        "source": "WORKSPACE",
        "base_parameters": {
          "raw_path": "s3://ipd-nayeli-s3/raw/deportistas_eventos_internacionales.csv",
          "silver_path": "s3://ipd-nayeli-s3/silver/eventos_internacionales"
        }
      },
      "timeout_seconds": 1200,
      "max_retries": 1,
      "min_retry_interval_millis": 30000
    },
    {
      "task_key": "silver_to_gold",
      "depends_on": [{"task_key": "s3_to_silver"}],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/nayeli.herrera@vallegrande.edu.pe/07-NayeliHerrera-BigData-Spark/notebooks/02_silver_to_gold",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 600,
      "max_retries": 1,
      "min_retry_interval_millis": 30000
    }
  ]
}
